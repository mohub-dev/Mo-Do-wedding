{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mo-do-wedding",
  "compatibility_date": "2024-09-23",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mo-do-wedding-db",
      "database_id": "f68e6ff6-8a49-4968-b837-2bc6de85f08a"
    }
  ]
}
