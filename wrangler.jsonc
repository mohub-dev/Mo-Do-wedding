{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mo-do-wedding",
  "compatibility_date": "2024-09-23",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mo-do-wedding-db",
      // NOTE: "mo-do-wedding-db" is used for local Miniflare simulation.
      // Before remote deployment, replace database_id with the real D1 UUID generated via `npx wrangler d1 create mo-do-wedding-db`
      "database_id": "mo-do-wedding-db"
    }
  ]
}
